  CEL:
    EXPRESSIONS:
      step height = ave(Y)@inlet_bottom - ave(Y)@ bottom_wall
    END
  END
END

EXPRESSION EVALUATOR:
  Evaluated Expression = step height
END

> forceupdate EXPRESSION EVALUATOR""")
